---
layout: default
---

<article class="h-entry" itemscope itemtype="https://schema.org/Article">
  <header>
    <% unless @this.post.portrait == false %>
      <figure>
        <img src="/images/interviews/<%= @this.post.slug %>/portrait.jpg" width="500" height="335" class="portrait u-photo" alt="A picture of <%= @this.post.title %>" itemprop="image">
        <% if @this.post.credits %>
          <figcaption>Image by <% if @this.post.credits.url %><a href="<%= @this.post.credits.url %>" title="More details about <%= @this.post.credits.name %>."><%= @this.post.credits.name %></a><% else %><%= @this.post.credits.name %><% end %><% if @this.post.credits.details %> (<%= @this.post.credits.details %>)<% end %><% if @this.post.credits.licence %> (<a href="http://creativecommons.org/licenses/<%= @this.post.credits.licence %>/4.0/" title="The <%= @this.post.credits.licence.upcase %> Creative Commons licence."><%= @this.post.credits.licence.upcase %></a>)<% end %>.</figcaption>
        <% end %>
      </figure>
    <% end %>
    <h2 class="p-name" itemprop="headline"><%= @this.post.title %></h2>
    <p class="summary p-job-title"><%= @this.post.summary %></p>
    <p class="details">
    <time datetime="<%= @this.post.date.strftime('%Y-%m-%d') %>" class="dt-published" itemprop="datePublished" content="<%= @this.post.date.strftime('%Y-%m-%d') %>"><%= @this.post.date.strftime('%B %d, %Y') %></time> in
    <% @this.post.categories.each do |slug| %>
      <a href="/categories/<%= slug %>/" title="All the <%= slug %> interviews." class="p-category"><%= slug %></a><%= ', ' unless @this.post.categories.last == slug %>
  <% end %>
  </header>
  <div class="e-content" itemprop="articleBody">
    <%= yield %>
    <% if @this.post.licence %><p id="licence"><strong>Note:</strong> This interview is available under the <a href="http://creativecommons.org/licenses/<%= @this.post.licence %>/4.0/" title="The <%= @this.post.licence.upcase %> Creative Commons licence."><%= @this.post.licence.upcase %> Creative Commons licence</a>.</p><% end %>
  </div>
</article>
